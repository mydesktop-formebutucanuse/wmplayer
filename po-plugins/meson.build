# The translations of the plugins (src/plugins, src/skins): those of
# audacious-plugins 4.6.2, without the texts of the plugins that are not here.

i18n = import('i18n')


i18n.gettext('wmplayer-plugins',
  args: [
    '--default-domain=wmplayer-plugins',
    '--package-name=wmplayer plugins',
    '--language=C',
    '--keyword=_',
    '--keyword=N_',
    '--from-code=UTF-8',
    '--directory=@0@'.format(meson.current_source_dir()),
  ]
)
